# ── Discord ─────────────────────────────────────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=
# Optional: register slash commands instantly in one development server.
GUILD_ID=

# ── General ─────────────────────────────────────────────────────────────
DATABASE_PATH=./data/carl-lite.sqlite
# IANA time zone for the AI clock tool and channel summaries, e.g. Asia/Jakarta.
BOT_TIMEZONE=UTC
# debug | info | warn | error. Set LOG_FORMAT=json for one JSON object per line.
LOG_LEVEL=info
LOG_FORMAT=pretty

# ── AI chat providers ───────────────────────────────────────────────────
# Primary provider: ollama | openai | none (empty = inferred from OLLAMA_MODEL / OPENAI_MODEL).
# The optional fallback answers automatically when the primary is down, slow or missing its model.
AI_PROVIDER=ollama
AI_FALLBACK_PROVIDER=

# Local models via Ollama: no API key and no per-request cost.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=90000
OLLAMA_KEEP_ALIVE=5m
# Context window to allocate. Ollama's small default silently cuts long prompts (RAG, memory).
OLLAMA_NUM_CTX=8192

# Any OpenAI-compatible API: OpenAI, OpenRouter, Groq, Together, LM Studio, vLLM, ...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=60000
# Reasoning models only: minimal | low | medium | high (defaults to low for GPT-5/o-series on api.openai.com).
OPENAI_REASONING_EFFORT=

# ── Embeddings: semantic search for the knowledge base and learning ─────
# Optional. Without an embedding model, retrieval uses keyword search (BM25) only.
# ollama | openai | none (empty = inferred from the model variables below).
AI_EMBED_PROVIDER=
# Multilingual model that handles Indonesian well: run `ollama pull bge-m3`, then set bge-m3.
OLLAMA_EMBED_MODEL=
# Cheap cloud option: text-embedding-3-small (uses OPENAI_BASE_URL and OPENAI_API_KEY).
OPENAI_EMBED_MODEL=
# Minimum cosine similarity for a semantic match (keyword matches always count).
AI_RAG_MIN_SIMILARITY=0.45

# ── AI behaviour ────────────────────────────────────────────────────────
AI_MAX_OUTPUT_TOKENS=1024
# Optional sampling temperature (0-2); ignored by reasoning models.
AI_TEMPERATURE=
# Let the model call read-only tools (time, server info, members, recent messages, knowledge base, warnings).
AI_TOOLS=true
# Send image attachments to vision-capable models (gemma3, qwen2.5vl, gpt-5-mini, ...).
AI_VISION=true
# Learning loops: 👍/👎 buttons, moderator corrections, moderation reviews, automatic memory facts.
AI_LEARNING=true
# Optional persona file, see personas/shy-gamer.example.json. Files named *.local.json are git-ignored.
AI_PERSONA_FILE=
